# ReconForge Environment Configuration
# Default network binding: 127.0.0.1 for local desktop security
# (Set to 0.0.0.0 only when deploying in containerized environments)
HOST=127.0.0.1
PORT=3000
NODE_ENV=development

# Inbound DNS Rebinding Protection: Additional allowed Host headers (comma-separated)
# (localhost:3000, 127.0.0.1:3000, etc. are allowed by default)
ALLOWED_HOSTS=localhost,127.0.0.1

# Strict CORS: Additional allowed browser Origins (comma-separated, exact match)
# (http://localhost:3000, http://127.0.0.1:3000 are allowed by default)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Public Deployment URL (auto-ingests hostname and origin into allowlists)
# APP_URL=https://recon.yourdomain.com
